	title = {{Energy}-{preserving} {muscle} {tissue} {model}: {Formulation} {and} {compatible} {discretizations}},
	url = {http://www.dl.begellhouse.com/journals/61fd1b191cf7e96f,42f1beba0b405e70,2491c81155ff42d6.html},
