@article{nicholls26,
  title = {Genome-Wide Analysis of Cardiac Ventricular Phenotypes Reveals Novel Loci and Therapeutic Targets for Heart Failure},
  author = { Nicholls, Hannah L. and Vargas, Jose D. and Sanghvi, Mihir M. and Ahn, Hyo-Suk and Chahal, C. Anwar A. and Khanji, Mohammed Y. and Petersen, Steffen E. and Munroe, Patricia B. and Aung, Nay },
  year = 2026,
  month = feb,
  journal = {Nature Communications},
  volume = {17},
  number = {1},
  pages = {3293},
  issn = {2041-1723},
  doi = {10.1038/s41467-026-69982-0},
  urldate = {2026-08-09},
  abstract = {Abstract                            Left and right ventricular imaging measures are essential for heart failure diagnosis and prognostication, yet their genetic architecture remains underexplored. We conduct genome-wide association analyses of twenty left and right cardiovascular magnetic resonance phenotypes in 56,509 UK Biobank participants, including conventional measurements (e.g., volumes/ejection fraction) and novel parameters (left ventricular global function index and myocardial contraction fraction). We identify 200 loci associated with at least one phenotype (               P               \,{$<$}\,5\texttimes 10               -8               ); 58 being novel. A polygenic risk score for left ventricular global function index negative associates with heart failure in phenome-wide scan. Rare variant analysis reveals enrichment of deleterious variants across 13 genes (               P               \,{$<$}\,2.5\texttimes 10               -6               ). Colocalisation with heart failure implicates 23 shared loci and bioinformatic analysis prioritises genes including               HSPB7, CAMK2D, ALDH2, ENG               , and               YWHAE               . Druggability analysis highlights               PDE3A               , informing divergent effects of non-selective PDE3 inhibition. In this work, we expand our knowledge of cardiac ventricular genetics, suggesting potential heart failure therapeutic targets.},
  langid = {english},
  file = {/Users/pfaller/Zotero/storage/NWZU9SFZ/Nicholls et al. - 2026 - Genome-wide analysis of cardiac ventricular phenotypes reveals novel loci and therapeutic targets fo.pdf}
}

