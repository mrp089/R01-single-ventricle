@article{sharifi26,
  title = {Role of Baroreflex Feedback Loop in Predictions of Left Ventricular Growth: {{A}} Multiscale Finite Element Modelling Study},
  shorttitle = {Role of Baroreflex Feedback Loop in Predictions of Left Ventricular Growth},
  author = { Sharifi, Hossein and Mehri, Mohammad and Campbell, Kenneth S. and Lee, Lik Chuan and Wenk, Jonathan F. },
  year = 2026,
  month = jul,
  journal = {The Journal of Physiology},
  volume = {604},
  number = {13},
  pages = {5535--5560},
  issn = {0022-3751, 1469-7793},
  doi = {10.1113/JP288649},
  urldate = {2026-08-09},
  abstract = {Abstract                                The heart functions within a complex system that adapts its function to alterations in loading via several mechanisms. For example, the baroreflex is a feedback loop that modulates the heart's function on a beat-to-beat basis to control arterial pressure. On the other hand, cardiac growth is an adaptive process that occurs over weeks or months in response to changes in left ventricular loading. In this study, we investigate the impact of a baroreflex feedback loop on left ventricular growth in simulations of valve disease. To achieve this, we integrated the effects of a baroreflex feedback loop and a growth algorithm into a beating multiscale finite element model of the left ventricle. Our integrated model replicated clinical measures of left ventricular growth in two types of valvular diseases -- aortic stenosis and mitral regurgitation -- at two different levels of severity for each case. Furthermore, our results showed that incorporating the effects of baroreflex control in simulations of left ventricular growth not only led to more realistic haemodynamics, but also impacted the magnitude of growth. Finally, our results suggest that the regulation of Ca                 2+                 dynamics by the baroreflex is a crucial mechanism in adapting the myocardial cell in response to altered loading due to aortic stenosis and mitral regurgitation.                                                         image                                                                                            Key points                                                                        The heart adapts its function in response to alterations in loading via short-term and long-term mechanisms.                                                           These mechanisms are essential for maintaining proper blood pressure in the vasculature (baroreflex) and homeostasis in the heart (ventricular growth).                                                           In this study, we investigate the impact of a baroreflex feedback loop on left ventricular growth in finite element simulations of valve disease.                                                           We showed that incorporating the effects of baroreflex control and ventricular growth not only led to more realistic haemodynamics, but also impacted the magnitude of growth.                                                                                  Our results suggest that the regulation of Ca                       2                       {$^+$} dynamics by the baroreflex is a crucial mechanism in adapting the myocardial cell in response to altered ventricular loading.},
  langid = {english}
}

