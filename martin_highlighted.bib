@article{qiao2025,
  title = {Modulation of Arterial Wall Remodeling by Mechanical Stress: {{Focus}} on Abdominal Aortic Aneurysm},
  shorttitle = {Modulation of Arterial Wall Remodeling by Mechanical Stress},
  author = { Qiao, Maolin and Li, Yaling and Yan, Sheng and Zhang, Rui Jing and Dong, Honglin },
  year = 2025,
  month = apr,
  journal = {Vascular Medicine},
  volume = {30},
  number = {2},
  pages = {238--249},
  issn = {1358-863X, 1477-0377},
  doi = {10.1177/1358863X241309836},
  urldate = {2026-07-21},
  abstract = {The rupture of an abdominal aortic aneurysm (AAA) poses a significant threat, with a high mortality rate, and the mechanical stability of the arterial wall determines both its growth and potential for rupture. Owing to extracellular matrix (ECM) degradation, wall-resident cells are subjected to an aberrant mechanical stress environment. In response to stress, the cellular mechanical signaling pathway is activated, initiating the remodeling of the arterial wall to restore stability. A decline in mechanical signal responsiveness, coupled with inadequate remodeling, significantly contributes to the AAA's progressive expansion and eventual rupture. In this review, we summarize the main stresses experienced by the arterial wall, emphasizing the critical role of the ECM in withstanding stress and the importance of stress-exposed cells in maintaining mechanical stability. Furthermore, we will discuss the application of biomechanical analyses as a predictive tool for assessing AAA stability.},
  langid = {english},
  file = {/Users/pfaller/Zotero/storage/UUMDGBAG/Qiao et al. - 2025 - Modulation of arterial wall remodeling by mechanical stress Focus on abdominal aortic aneurysm.pdf}
}

