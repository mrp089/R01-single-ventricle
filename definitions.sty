% boxed figure
%   #1 placement (l|r)   #2 width (e.g. 0.48\linewidth)
%   #3 graphics          #4 caption body (start with \footnotesize\textbf{Fig.~N.})
%   #5 label
\newcommand{\boxedwrapfig}[5]{%
  \setlength{\columnsep}{0pt}% <-- BEFORE \begin{wrapfigure}
  \begin{wrapfigure}{#1}{#2}%
    \vspace{-0.8em}%
    \setlength{\fboxsep}{1pt}%
    \centering%
    \fbox{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}%
      \centering%
      #3%
      \caption{#4}%
      \label{#5}%
    \end{minipage}}%
    \vspace{-1em}%
  \end{wrapfigure}%
}